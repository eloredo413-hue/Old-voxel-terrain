local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_LOOKUP = {}
for i = 1, #B64_CHARS do
	B64_LOOKUP[string.byte(B64_CHARS, i)] = i - 1
end

local function decodeBase64(b64Str)
	local out = {}
	local n = #b64Str
	local i = 1
	while i <= n do
		local c1 = B64_LOOKUP[string.byte(b64Str, i)] or 0
		local c2 = B64_LOOKUP[string.byte(b64Str, i + 1)] or 0
		local b3 = string.byte(b64Str, i + 2)
		local b4 = string.byte(b64Str, i + 3)
		local c3 = B64_LOOKUP[b3] or 0
		local c4 = B64_LOOKUP[b4] or 0

		local triple = c1 * 262144 + c2 * 4096 + c3 * 64 + c4
		local byte1 = math.floor(triple / 65536) % 256
		local byte2 = math.floor(triple / 256) % 256
		local byte3 = triple % 256

		if b3 == 61 then
			out[#out + 1] = string.char(byte1)
		elseif b4 == 61 then
			out[#out + 1] = string.char(byte1, byte2)
		else
			out[#out + 1] = string.char(byte1, byte2, byte3)
		end
		i = i + 4
	end
	return table.concat(out)
end

local TEXTURE_ASSETS = {}
local HAS_CUSTOM_ASSETS = false

local TEXTURE_KEYS = {
	"Grass", "Dirt", "Sand", "Brick", "Granite", "Asphalt", "IronPlate", "AluminumPlate", "WoodPlanks", "Logs",
	"Gravel", "Cinderblock", "MossyRock", "Concrete"
